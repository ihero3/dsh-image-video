{
  "name": "dsh-image-video",
  "version": "0.3.18",
  "description": "DeepSeek Harness 插件：文生图/图生图与文生/图生视频工具，支持 Threerouter / 万象 wanx / MiniMax / Seedance2.5 服务商、凭证缝引用、媒体模式注入、异步轮询与 UI-only 图片预览",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/plugin.d.ts",
      "default": "./lib/client/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client/**",
    "lib/types/client/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "bundle": "pnpm run build",
    "build": "pnpm run clean && tsdown && tsc -p tsconfig.client.json",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "pnpm run typecheck && echo OK",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "image-generation",
    "video-generation",
    "wanx",
    "seedance"
  ],
  "author": "ihero3",
  "license": "MIT",
  "homepage": "https://github.com/ihero3/dsh-image-video#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ihero3/dsh-image-video.git"
  },
  "bugs": {
    "url": "https://github.com/ihero3/dsh-image-video/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@xyflow/react": "12.12.0",
    "jsdom": "^30.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
